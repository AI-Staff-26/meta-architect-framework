# Whitelist: игнорировать всё по умолчанию, коммитить только фреймворк.
# Новые runtime-папки Claude Code (daemon/, jobs/, telemetry/, sessions/, cache/...)
# не попадают в git автоматически — их не нужно добавлять в этот файл.

*

# Разрешить только фреймворк
!.gitignore
!CLAUDE.md
!agents/
!agents/**
!rules/
!rules/**
!skills/
!skills/**
!VERSION
!CHANGELOG.md
!README.md
!.github/
!.github/**
